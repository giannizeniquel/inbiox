DATABASE_URL="mysql://app:app@db:3306/inbiox?serverVersion=8.0&charset=utf8mb4"
DEFAULT_URI=http://localhost

###> symfony/mercure-bundle ###
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# The secret used to sign the JWTs (use a strong secret in production)
MERCURE_JWT_SECRET="dev-secret-change-in-production"
###< symfony/mercure-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> inbiox/meta ###
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
###< inbiox/meta ###
