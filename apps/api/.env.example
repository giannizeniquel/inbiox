DATABASE_URL="mysql://app:app@db:3306/inbiox?serverVersion=8.0&charset=utf8mb4"
DEFAULT_URI=http://localhost

###> symfony/mercure-bundle ###
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# The secret used to sign the JWTs (use a strong secret in production)
MERCURE_JWT_SECRET="40127d4eb35fc78be0315e2810d2f09f0cff9880f0a49fd5df0fc690e739ea9c"
###< symfony/mercure-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> inbiox/meta ###
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
###< inbiox/meta ###

###> inbiox/media-storage (S3-compatible: MinIO dev / Cloudflare R2 prod) ###
S3_ENDPOINT=http://minio:9000
# Public endpoint used to generate pre-signed URLs (reachable from the browser).
# Dev: http://localhost:9000 (host-exposed MinIO). Prod: same as S3_ENDPOINT (R2).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=inbiox-media
S3_KEY=app
S3_SECRET=app-secret
S3_REGION=us-east-1
MEDIA_URL_TTL=300
MEDIA_ENABLED=true
###< inbiox/media-storage ###

###> inbiox/security ###
# Refresh-token cookie "Secure" flag.
# Dev (HTTP): 0. Production (HTTPS, mandatory): 1.
REFRESH_COOKIE_SECURE=0
###< inbiox/security ###

###> inbiox/conversation-window ###
# WhatsApp 24h conversation-window compliance: safety margin subtracted
# from the literal 24h boundary (spec.md default: 5 minutes).
CONVERSATION_WINDOW_SAFETY_MARGIN_MINUTES=5
###< inbiox/conversation-window ###
